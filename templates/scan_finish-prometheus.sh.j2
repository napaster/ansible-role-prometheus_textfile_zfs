#!/usr/bin/bash
# ZED hook — после scrub_finish / resilver_finish немедленно обновить textfile,
# чтобы метрики последнего scrub/resilver были свежими (а не ждать cron).
#
# Managed by Ansible (role prometheus_textfile_zfs). Do not edit manually.
#
# Устанавливается symlink'ами в /etc/zfs/zed.d/:
#   scrub_finish-prometheus.sh
#   resilver_finish-prometheus.sh
#
# Каталог назначения передаём явно: у скрипта свой дефолт, и если на хосте
# node_exporter читает другой каталог — хук писал бы мимо сбора.

export TEXTFILE_DIR='{{ prometheus_textfile_zfs_textfile_dir }}'
export TEXTFILE_NAME='{{ prometheus_textfile_zfs_textfile_name }}'

exec {{ prometheus_textfile_zfs_script_dest }}
